<?xml version="1.0" encoding="utf-8"?>
<!--
  Folder overflow bottom sheet — spec §6.3 FoldersLibraryPage three-dot menu.
  5 actions per the mock: Rename · Change Color · Bookmark · Information · Trash.
  Mirrors bottom_sheet_note_overflow; reuses OverflowRow style.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingTop="@dimen/space_md"
    android:paddingBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="@dimen/space_md">

        <TextView
            android:id="@+id/folderNameTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_high_contrast"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="Calculus"
            xmlns:tools="http://schemas.android.com/tools" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/overflow_close"
            android:tint="@color/text_muted" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_container_high"
        android:layout_marginBottom="@dimen/space_sm" />

    <LinearLayout android:id="@+id/rowRename" style="@style/OverflowRow">
        <ImageView style="@style/OverflowRowIcon" android:src="@drawable/ic_overflow_rename" />
        <TextView style="@style/OverflowRowLabel" android:text="@string/overflow_rename" />
    </LinearLayout>

    <LinearLayout android:id="@+id/rowChangeColor" style="@style/OverflowRow">
        <ImageView style="@style/OverflowRowIcon" android:src="@drawable/ic_overflow_change_color" />
        <TextView style="@style/OverflowRowLabel" android:text="@string/overflow_change_color" />
    </LinearLayout>

    <LinearLayout android:id="@+id/rowBookmark" style="@style/OverflowRow">
        <ImageView android:id="@+id/iconBookmark" style="@style/OverflowRowIcon" android:src="@drawable/ic_overflow_bookmark" />
        <TextView android:id="@+id/labelBookmark" style="@style/OverflowRowLabel" android:text="@string/overflow_bookmark" />
    </LinearLayout>

    <LinearLayout android:id="@+id/rowInfo" style="@style/OverflowRow">
        <ImageView style="@style/OverflowRowIcon" android:src="@drawable/ic_overflow_info" />
        <TextView style="@style/OverflowRowLabel" android:text="@string/overflow_information" />
    </LinearLayout>

    <LinearLayout android:id="@+id/rowTrash" style="@style/OverflowRow">
        <ImageView style="@style/OverflowRowIcon" android:src="@drawable/ic_overflow_trash" android:tint="@color/thunder_primary" />
        <TextView style="@style/OverflowRowLabel" android:text="@string/overflow_trash" android:textColor="@color/thunder_primary" />
    </LinearLayout>
</LinearLayout>
