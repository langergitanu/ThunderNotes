<?xml version="1.0" encoding="utf-8"?>
<!--
  CanvasActivity layout — the full-screen note editor.

  Mirrors the structural regions of the Frontend `canvasLayoutPage` mock:
   1. Top app bar     — back / title / page indicator / overflow
   2. Workflow row    — undo · redo · zoom − % + · add page · AI-snip
   3. Pen tray        — 6 tools (PEN/HIGHLIGHTER/ERASER/LASSO/SHAPE/TEXT)
                        + secondary row: color swatches + stroke widths
                        (both shown/hidden per the selected tool's rules)
   4. Page surface    — scrollable area hosting the (placeholder) page card
                        The AndroidX Ink InProgressStrokesView attaches here in Phase 7.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas_bg"
    android:fitsSystemWindows="true">

    <!-- ═══ [1] Top app bar ════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/canvas_surface_low"
        android:paddingHorizontal="@dimen/space_md">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_canvas_tool"
            android:src="@drawable/ic_editor_back"
            android:contentDescription="@string/canvas_back"
            android:tint="@color/canvas_on_surface" />

        <EditText
            android:id="@+id/noteTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_md"
            android:background="@android:color/transparent"
            android:hint="@string/canvas_title_hint"
            android:textColorHint="@color/canvas_on_surface_variant"
            android:textColor="@color/canvas_on_surface"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:inputType="text|textCapSentences" />

        <TextView
            android:id="@+id/pageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:textColor="@color/canvas_on_surface_variant"
            android:textSize="13sp"
            tools:text="1 / 1"
            xmlns:tools="http://schemas.android.com/tools" />

        <ImageButton
            android:id="@+id/btnThemeToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_canvas_tool"
            android:src="@drawable/ic_editor_theme"
            android:contentDescription="@string/canvas_theme_toggle"
            android:tint="@color/canvas_on_surface_variant" />

        <ImageButton
            android:id="@+id/btnOverflow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_canvas_tool"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="@string/canvas_more"
            android:tint="@color/canvas_on_surface_variant" />
    </LinearLayout>

    <!-- ═══ [2] Workflow row ═══════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/canvas_bg_dim"
        android:paddingHorizontal="@dimen/space_md">

        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_canvas_tool"
            android:src="@drawable/ic_editor_undo"
            android:contentDescription="@string/canvas_undo"
            android:tint="@color/canvas_on_surface_variant" />

        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_canvas_tool"
            android:src="@drawable/ic_editor_redo"
            android:contentDescription="@string/canvas_redo"
            android:tint="@color/canvas_on_surface_variant" />

        <!-- Paste button — glows (emerald ring) while ThunderClipboard holds 1 item.
             Tapping drops the item onto the canvas via InkInjector (Phase 8b). -->
        <ImageButton
            android:id="@+id/btnPaste"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_canvas_tool"
            android:src="@drawable/ic_editor_paste"
            android:contentDescription="@string/canvas_paste"
            android:tint="@color/canvas_on_surface_variant" />

        <!-- spacer pushes zoom group to center-right -->
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnZoomOut"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_canvas_tool"
            android:src="@drawable/ic_editor_zoom_out"
            android:contentDescription="@string/canvas_zoom_out"
            android:tint="@color/canvas_on_surface_variant" />

        <TextView
            android:id="@+id/zoomIndicator"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:textColor="@color/canvas_on_surface"
            android:textSize="13sp"
            android:fontFamily="monospace"
            tools:text="100%"
            xmlns:tools="http://schemas.android.com/tools" />

        <ImageButton
            android:id="@+id/btnZoomIn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_canvas_tool"
            android:src="@drawable/ic_editor_zoom_in"
            android:contentDescription="@string/canvas_zoom_in"
            android:tint="@color/canvas_on_surface_variant" />

        <!-- Gridline toggle (spec §6.10 Row 2c). Long-press → m×n presets popup. -->
        <ImageButton
            android:id="@+id/btnGridline"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_canvas_tool"
            android:src="@drawable/ic_editor_grid"
            android:contentDescription="@string/canvas_gridline"
            android:tint="@color/canvas_on_surface_variant" />

        <!-- Scale ruler (§6.10 Row 2c). Long-press → rotation-angle presets. -->
        <ImageButton
            android:id="@+id/btnRuler"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_canvas_tool"
            android:src="@drawable/ic_editor_ruler"
            android:contentDescription="@string/canvas_ruler"
            android:tint="@color/canvas_on_surface_variant" />

        <!-- Image insert (§6.10 Row 2b). Tap → image picker. -->
        <ImageButton
            android:id="@+id/btnImage"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_canvas_tool"
            android:src="@drawable/ic_editor_image"
            android:contentDescription="@string/canvas_image"
            android:tint="@color/canvas_on_surface_variant" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnAddPage"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_canvas_tool"
            android:src="@drawable/ic_editor_add_page"
            android:contentDescription="@string/canvas_add_page"
            android:tint="@color/canvas_on_surface_variant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAiSnip"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/canvas_ai_snip"
            android:textColor="@color/canvas_tertiary"
            app:icon="@drawable/ic_editor_ai_snip"
            app:iconTint="@color/canvas_tertiary"
            app:iconSize="18dp" />
    </LinearLayout>

    <!-- ═══ [3] Pen tray ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/canvas_surface_low"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_sm">

        <!-- Tool row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/toolTray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/toolPen"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:background="@drawable/bg_canvas_tool"
                    android:src="@drawable/ic_editor_pen"
                    android:contentDescription="@string/canvas_tool_pen"
                    android:tint="@color/canvas_tool_inactive_tint" />

                <ImageButton
                    android:id="@+id/toolHighlighter"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:background="@drawable/bg_canvas_tool"
                    android:src="@drawable/ic_editor_highlighter"
                    android:contentDescription="@string/canvas_tool_highlighter"
                    android:tint="@color/canvas_tool_inactive_tint" />

                <ImageButton
                    android:id="@+id/toolEraser"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:background="@drawable/bg_canvas_tool"
                    android:src="@drawable/ic_editor_eraser"
                    android:contentDescription="@string/canvas_tool_eraser"
                    android:tint="@color/canvas_tool_inactive_tint" />

                <ImageButton
                    android:id="@+id/toolLasso"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:background="@drawable/bg_canvas_tool"
                    android:src="@drawable/ic_editor_lasso"
                    android:contentDescription="@string/canvas_tool_lasso"
                    android:tint="@color/canvas_tool_inactive_tint" />

                <ImageButton
                    android:id="@+id/toolShape"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:background="@drawable/bg_canvas_tool"
                    android:src="@drawable/ic_editor_shape"
                    android:contentDescription="@string/canvas_tool_shape"
                    android:tint="@color/canvas_tool_inactive_tint" />

                <ImageButton
                    android:id="@+id/toolText"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:background="@drawable/bg_canvas_tool"
                    android:src="@drawable/ic_editor_text"
                    android:contentDescription="@string/canvas_tool_text"
                    android:tint="@color/canvas_tool_inactive_tint" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Secondary options row: color swatches + stroke widths.
             Visibility toggled from code based on the active tool. -->
        <LinearLayout
            android:id="@+id/optionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/space_sm">

            <!-- Palette switcher (spec §6.10 Row 3c: ThunderDark / ThunderLight /
                 Sunflower). Tap → PopupMenu to switch the active 8-color palette. -->
            <TextView
                android:id="@+id/paletteSwitcher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="6dp"
                android:text="ThunderDark"
                android:textColor="@color/canvas_on_surface"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_canvas_tool"
                android:clickable="true"
                android:focusable="true" />

            <!-- Line-type switcher (spec §6.10 Row 3a: straight / dotted / dashed).
                 Tap → PopupMenu. Shown only for pens + highlighter (render() toggles). -->
            <TextView
                android:id="@+id/lineTypeSwitcher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="6dp"
                android:text="Straight"
                android:textColor="@color/canvas_on_surface"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_canvas_tool"
                android:clickable="true"
                android:focusable="true" />

            <!-- Shape-type switcher (§6.10 Row 3g). Shown only for the SHAPE tool. -->
            <TextView
                android:id="@+id/shapeTypeSwitcher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="6dp"
                android:text="Rectangle"
                android:textColor="@color/canvas_on_surface"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_canvas_tool"
                android:clickable="true"
                android:focusable="true" />

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/colorSwatchesContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/strokeWidthContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="@dimen/space_md" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ [4] Page surface + pages sidebar (minimap, canvasUtilityPage) ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:id="@+id/pageScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/canvas_bg_dim"
            android:fillViewport="true">

            <!-- pagesContainer: stacked page items with dotted separators between
                 (spec §6.10 Canvas Area: "no gap between two pages; only a dotted
                 line separator" — the infinite-vertical-canvas feel). Pages are
                 added in code by CanvasActivity as item_canvas_page views. -->
            <LinearLayout
                android:id="@+id/pagesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="@dimen/space_lg" />
        </ScrollView>

        <!-- Pages sidebar / minimap (spec §7.6 + canvasUtilityPage right side):
             vertical strip of page-number chips; tap to jump (scroll) to a page.
             Populated in code by CanvasActivity.addPageItem. -->
        <ScrollView
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="@color/canvas_surface_low"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/pagesSidebar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingVertical="@dimen/space_sm" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
