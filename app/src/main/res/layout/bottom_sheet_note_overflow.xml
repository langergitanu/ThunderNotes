<?xml version="1.0" encoding="utf-8"?>
<!--
  Note overflow bottom sheet — spec §6.2.4 three-dot menu.
  Pattern adapted from Samsung Notes' per-document option menu: a sheet of
  action rows (icon + label), one per overflow function.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingTop="@dimen/space_md"
    android:paddingBottom="@dimen/space_sm">

    <!-- Header: note name + close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="@dimen/space_md">

        <TextView
            android:id="@+id/noteNameTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_high_contrast"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="Math Lecture 3"
            xmlns:tools="http://schemas.android.com/tools" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/overflow_close"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_container_high"
        android:layout_marginBottom="@dimen/space_sm" />

    <!-- Action rows. Each: icon (24dp) + label. Bookmark label toggles in code. -->
    <LinearLayout
        android:id="@+id/rowRename"
        style="@style/OverflowRow">
        <ImageView style="@style/OverflowRowIcon" android:src="@drawable/ic_overflow_rename" />
        <TextView android:id="@+id/labelRename" style="@style/OverflowRowLabel" android:text="@string/overflow_rename" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowCover"
        style="@style/OverflowRow">
        <ImageView style="@style/OverflowRowIcon" android:src="@drawable/ic_overflow_cover" />
        <TextView style="@style/OverflowRowLabel" android:text="@string/overflow_change_cover" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowMove"
        style="@style/OverflowRow">
        <ImageView style="@style/OverflowRowIcon" android:src="@drawable/ic_overflow_move" />
        <TextView style="@style/OverflowRowLabel" android:text="@string/overflow_move" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowExport"
        style="@style/OverflowRow">
        <ImageView style="@style/OverflowRowIcon" android:src="@drawable/ic_overflow_export" />
        <TextView style="@style/OverflowRowLabel" android:text="@string/overflow_export" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowBookmark"
        style="@style/OverflowRow">
        <ImageView android:id="@+id/iconBookmark" style="@style/OverflowRowIcon" android:src="@drawable/ic_overflow_bookmark" />
        <TextView android:id="@+id/labelBookmark" style="@style/OverflowRowLabel" android:text="@string/overflow_bookmark" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowInfo"
        style="@style/OverflowRow">
        <ImageView style="@style/OverflowRowIcon" android:src="@drawable/ic_overflow_info" />
        <TextView style="@style/OverflowRowLabel" android:text="@string/overflow_information" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowTrash"
        style="@style/OverflowRow">
        <ImageView style="@style/OverflowRowIcon" android:src="@drawable/ic_overflow_trash" app:tint="@color/thunder_primary" />
        <TextView style="@style/OverflowRowLabel" android:text="@string/overflow_trash" android:textColor="@color/thunder_primary" />
    </LinearLayout>

</LinearLayout>
