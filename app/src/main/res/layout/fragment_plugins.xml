<?xml version="1.0" encoding="utf-8"?>
<!-- Plugins page — placeholder "coming soon". Plugin system under development. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/surface_base"
    android:padding="@dimen/space_xxl">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_sidebar_plugins"
        app:tint="@color/text_subtle"
        android:contentDescription="@string/title_plugins" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/plugins_coming_soon_title"
        android:textColor="@color/text_high_contrast"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center"
        android:text="@string/plugins_coming_soon_message"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />
</LinearLayout>
