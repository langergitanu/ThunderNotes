<?xml version="1.0" encoding="utf-8"?>
<!-- ImportFilePage — message + "Select .thunder file" button. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/surface_base"
    android:padding="@dimen/space_xxl">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_import"
        app:tint="@color/thunder_accent_blue"
        android:contentDescription="@string/action_import" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/title_import_file"
        android:textColor="@color/text_high_contrast"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center"
        android:text="@string/import_file_message"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/select_file_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/import_file_button"
        app:icon="@drawable/ic_import"
        app:iconTint="@color/white"
        android:backgroundTint="@color/thunder_accent_blue"
        android:textColor="@color/white" />
</LinearLayout>
