<?xml version="1.0" encoding="utf-8"?>
<!-- Dotted horizontal separator between canvas pages (spec §6.10 Canvas Area:
     "no gap between two pages; only a dotted line separator"). A 2dp-tall
     rectangle whose dashed top+bottom strokes read as a dotted line. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size android:height="2dp" />
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/canvas_page_ink_hint"
        android:dashWidth="3dp"
        android:dashGap="4dp" />
</shape>
