<?xml version="1.0" encoding="utf-8"?>
<!-- Paste-button "glow" background (spec §6.10 Row 2: "glows as long as the
     app clipboard holds exactly one copied item"). An emerald ring + soft
     emerald fill, applied while ThunderClipboard.hasItem is true. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#334EDEA3" />
    <corners android:radius="10dp" />
    <stroke android:width="2dp" android:color="@color/canvas_secondary" />
</shape>
