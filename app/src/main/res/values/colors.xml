<resources>
    <!-- ─── Obsidian Precision Note System ───────────────────────────────────
         The design system documented in
         docs/Mock-UI-README.md and the canvasLayoutPage.md design spec.

         Dark Tactile Modernism: deep charcoal grounds + high-chroma functional accents.
         Surfaces scale through 4 distinct dark neutral steps rather than pure black,
         preserving depth while maintaining comfortable contrast.

         Primary   = Vivid Crimson   — primary CTAs, active nav, primary pen tools
         Secondary = Vibrant Emerald — additive actions (Create Folder), success
         Tertiary  = Warm Amber       — favorites, starred, pinned
         Accent    = Sky/Cobalt Blue  — tool sub-actions, stylus status, cloud chips
    ─────────────────────────────────────────────────────────────────────────── -->

    <!-- Brand palette -->
    <color name="thunder_primary">#DC2646</color>
    <color name="thunder_primary_bright">#E63956</color>
    <color name="thunder_primary_dark">#920025</color>

    <color name="thunder_secondary">#10B981</color>
    <color name="thunder_secondary_dark">#059669</color>

    <color name="thunder_tertiary">#F59E0B</color>
    <color name="thunder_tertiary_dark">#A16600</color>

    <color name="thunder_accent_blue">#3B82F6</color>

    <!-- ─── Surface tiers ──────────────────────────────────────────────────────
         Values aligned with the FORMAL DESIGN TOKENS at the top of the spec
         (canvasLayoutPage.md `colors:` block), NOT the body "Surface Hierarchy"
         prose which had stale values (#111115, #18181C, #222228, #2A2A32).

         BigPickle verified on the OnePlus Pad 2 (BigPickle.txt Sync 2 round 3,
         Open Issue 2) that the OLD colors rendered as #111115; we updated to
         #131317 to match the formal tokens. The visual difference is minimal
         (slightly lighter charcoal) but this gives us a consistent Material 3
         design-token naming scheme.

         The custom `surface_overlay` token is KEPT at #2A2A32 (matches the
         spec body's "Layer 3 Floating Overlays & Tooltips" rendered value)
         for popovers/dialogs that need a slightly different shade than
         `surface_container_highest`. Phase 5 UI can choose either.
    ─────────────────────────────────────────────────────────────────────────── -->
    <color name="surface_base">#131317</color>              <!-- spec: surface — Layer 0: canvas backdrop -->
    <color name="surface_container_lowest">#0E0E12</color> <!-- spec: surface-container-lowest -->
    <color name="surface_container_low">#1B1B1F</color>    <!-- spec: surface-container-low — Layer 1: sidebar, top bar -->
    <color name="surface_container">#1F1F23</color>        <!-- spec: surface-container — Layer 2: cards, toolbar -->
    <color name="surface_container_high">#2A292E</color>   <!-- spec: surface-container-high — Layer 2 raised -->
    <color name="surface_container_highest">#353439</color><!-- spec: surface-container-highest — deepest container -->
    <color name="surface_bright">#39393D</color>           <!-- spec: surface-bright — brightest surface (for inverse themes) -->
    <color name="surface_overlay">#2A2A32</color>           <!-- custom: Layer 3 floating overlays (popovers, dialogs) — matches spec body's rendered value -->

    <!-- Text -->
    <color name="text_high_contrast">#F9FAFB</color>
    <color name="text_muted">#9CA3AF</color>
    <color name="text_subtle">#6B7280</color>

    <!-- Borders / dividers -->
    <color name="border_default">#14FFFFFF</color>          <!-- rgba(255,255,255,0.08) -->
    <color name="border_strong">#33FFFFFF</color>

    <!-- Whites / blacks -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>

    <!-- ─── Launcher icon colors ───────────────────────────────────────────── -->
    <!-- Per spec §1.3: "A large thunder icon in the center with a red background." -->
    <color name="ic_launcher_background">@color/thunder_primary</color>
    <color name="ic_launcher_foreground">#FFFFFFFF</color>

