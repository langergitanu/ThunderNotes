<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ─── App-level theme (always dark per spec §6.10 Row 1 right) ──────────
         Base: Material3 Dark, NoActionBar (we use a custom app bar).
         The canvas theme toggle (dark↔light) is IN-CANVAS ONLY; the app-level
         chrome is always dark.
    ─────────────────────────────────────────────────────────────────────────── -->
    <style name="Theme.ThunderNotes" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Surfaces -->
        <item name="android:windowBackground">@color/surface_base</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Window drawing behavior.
             statusBarColor / navigationBarColor are declared ONCE here as
             transparent (edge-to-edge); the earlier duplicate pair that first
             set them to @color/surface_base was removed — a <style> may only
             define each attribute once, and the transparent value is the one
             that actually takes effect with windowDrawsSystemBarBackgrounds. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>

        <!-- Brand colors -->
        <item name="colorPrimary">@color/thunder_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/thunder_primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondary">@color/thunder_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/thunder_secondary_dark</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <item name="colorTertiary">@color/thunder_tertiary</item>
        <item name="colorOnTertiary">@color/black</item>

        <!-- Default text colors -->
        <item name="android:textColorPrimary">@color/text_high_contrast</item>
        <item name="android:textColorSecondary">@color/text_muted</item>

        <!-- Default background -->
        <item name="android:colorBackground">@color/surface_base</item>
        <item name="colorSurface">@color/surface_container_low</item>
        <item name="colorOnSurface">@color/text_high_contrast</item>
    </style>

    <!-- ─── Canvas activity theme ─────────────────────────────────────────────
         Full-bleed canvas (no system bar tint), used by CanvasActivity.
         The canvas itself manages its own theme (dark/light toggle).
    ─────────────────────────────────────────────────────────────────────────── -->
    <style name="Theme.ThunderNotes.Canvas" parent="Theme.ThunderNotes">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/surface_base</item>
    </style>

    <!-- ─── Overflow / bottom-sheet row styles (Phase 7) ───────────────────── -->
    <!-- One action row in a per-item overflow sheet (Samsung-style option menu). -->
    <style name="OverflowRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/space_md</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="OverflowRowIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginEnd">@dimen/space_md</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/text_high_contrast</item>
    </style>

    <style name="OverflowRowLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_high_contrast</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Info-sheet row: label (small, muted) above value (medium, high-contrast). -->
    <style name="InfoRowLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="InfoRowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_high_contrast</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>
</resources>
