<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ─── Permissions ───────────────────────────────────────────────────────
         INTERNET                     — snip API calls (Gemini / GLM) + future sync
         ACCESS_NETWORK_STATE         — detect online before snip chain
         SYSTEM_ALERT_WINDOW          — AI-snip floating button (overlay on other apps)
         FOREGROUND_SERVICE           — for both snip services
         FOREGROUND_SERVICE_SPECIAL_USE — the overlay-button service type (Android 14+)
         FOREGROUND_SERVICE_MEDIA_PROJECTION — screen capture for snip
         READ_MEDIA_IMAGES            — add images from gallery to canvas
         POST_NOTIFICATIONS           — Android 13+ foreground-service notification
         RECEIVE_BOOT_COMPLETED       — restore snip overlay after reboot (optional)
         WAKE_LOCK                    — keep CPU awake during long OCR runs
         READ_EXTERNAL_STORAGE        — legacy (<= API 28) gallery access (maxSdk 28)
    ─────────────────────────────────────────────────────────────────────────── -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Stylus features (declared so Play filters us visible to tablet users with stylus) -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />
    <uses-feature android:name="android.hardware.type.tablet" android:required="false" />

    <!-- ─── Live injection ingress permission (thunder-format-proposal Part B2) ───
         Guards the InjectContentReceiver so only authorized callers can push
         strokes/textboxes into ThunderNotes' clipboard while a note is open. -->
    <permission
        android:name="com.thundernotes.permission.INJECT"
        android:protectionLevel="normal"
        android:label="Inject content into ThunderNotes" />
    <uses-permission android:name="com.thundernotes.permission.INJECT" />

    <application
        android:name=".ThunderNotesApp"
        android:allowBackup="true"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="false"
        android:theme="@style/Theme.ThunderNotes"
        tools:targetApi="34">

        <!-- Launcher activity (will become a NavHost once we wire up screens) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout|density|fontScale|locale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ThunderNotes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ─── Canvas editor (Phase 6) ──────────────────────────────────────
             Full-screen note editor hosted in its own Activity (the canvas needs
             the whole screen for the pen tray + page surface + AI-snip overlay,
             with the sidebar hidden). Launched with an optional NOTE_ID extra;
             absent → the editor creates a fresh untitled note. -->
        <activity
            android:name=".ui.canvas.CanvasActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout|density|fontScale|locale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ThunderNotes.Canvas" />

        <!-- ─── External live-injection receiver (Phase 8b, thunder-format-proposal
             Part B2) — pushes a stroke-group/textbox payload into ThunderNotes'
             clipboard while a note is open; the paste button then glows. Guarded
             by the INJECT permission (signature/normal) so only authorized callers
             can inject. Exported so external tools + ADB can reach it. -->
        <receiver
            android:name=".inject.InjectContentReceiver"
            android:exported="true"
            android:permission="com.thundernotes.permission.INJECT">
            <intent-filter>
                <action android:name="com.thundernotes.action.INJECT_CONTENT" />
            </intent-filter>
        </receiver>

        <!-- ─── External stroke/textbox injection ingress (phase 2+) ──────────
             ContentProvider exposing content://com.thundernotes.inject/inject
             Used by:
               - the AI-snip floating service (in-process)
               - external plugin tools (signature-permission protected)
               - ADB intent action com.thundernotes.action.INJECT_CONTENT (debug builds)
        ───────────────────────────────────────────────────────────────────────────
        (Uncomment when InjectContentProvider lands.)

        <provider
            android:name=".inject.InjectContentProvider"
            android:authorities="com.thundernotes.inject"
            android:exported="true"
            android:grantUriPermissions="false"
            android:readPermission="com.thundernotes.permission.INJECT"
            android:writePermission="com.thundernotes.permission.INJECT" />

        <intent-filter>
            <action android:name="com.thundernotes.action.INJECT_CONTENT" />
            <category android:name="android.intent.category.DEFAULT" />
        </intent-filter>
        -->

        <!-- ─── AI-snip overlay service (§7.3.1) ───────────────────────────
             Foreground service hosting the SYSTEM_ALERT_WINDOW floating snip
             button. Survives app backgrounding as long as the user has granted
             overlay permission. The button is draggable; on tap it launches the
             SnipCaptureActivity which requests MediaProjection + captures the
             screen → region selection → SnipBottomSheet pipeline.

             FGS type = specialUse (NOT mediaProjection): this service never
             captures anything itself, and Android 14+ only allows the
             mediaProjection type to START after capture consent — using it
             here crashed the app at launch. The subtype property documents
             the special use for Play review (required by API 34+).
        -->
        <service
            android:name=".snip.SnipOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent floating AI-snip capture button shown over other apps while ThunderNotes is running." />
        </service>

        <!-- ─── Snip projection service (Android 14+ compliance) ──────────
             Short-lived foreground service holding the mediaProjection FGS
             type DURING a screen capture only (started from
             SnipCaptureActivity.onActivityResult, right after the user grants
             the capture consent dialog, and stopped when the frame is read).
             Android 14+ requires a running mediaProjection-type FGS before
             createVirtualDisplay() is legal. -->
        <service
            android:name=".snip.SnipProjectionService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- SnipCaptureActivity — the MediaProjection capture host (launched
             from the floating overlay button; transparent activity, no UI). -->
        <activity
            android:name=".snip.SnipCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- FileProvider for the Export share Intent (spec §6.2.5 Export).
             Exposes .thunder files under getExternalFilesDir/notes/ so they
             can be shared via ACTION_SEND (Save to Downloads, cloud, etc.). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
